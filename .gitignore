
# ==========================================
# Unity .gitignore
# ==========================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Addressables generated content
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Autogenerated Visual Scripting files
/[Aa]ssets/Unity.VisualScripting.Generated/

# IDE and editor files
.vs/
.vscode/
.idea/
.gradle/
.consulo/

# Visual Studio / Rider generated files
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
*.stackdump

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100
.Trashes

# Build artifacts
*.apk
*.aab
*.unitypackage

# Test results
/[Tt]est[Rr]esults/

# Optional local environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
